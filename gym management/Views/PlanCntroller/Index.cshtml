@using gym_management.Entities
@model IEnumerable<Plan>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- BACKEND: Everything outside <main class="content"> is the same on every page-->
    <!-- BACKEND: Page title · Route Gym -->
    <title>Plans · Route Gym</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- BACKEND: assets/ folder -->
    <link rel="stylesheet" href="assets/bootstrap-icons/font/bootstrap-icons.min.css" />
    <!-- BACKEND: assets/ folder -->
    <link rel="stylesheet" href="assets/css/route.css" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <!-- BACKEND: Links  instead of .html files -->
            <a class="brand" href="index.html">
                <span class="brand-mark">R</span>
                <span class="brand-text">
                    <span class="brand-name">ROUTE</span>
                    <span class="brand-sub">Gym Management</span>
                </span>
            </a>

            <nav>
                <div class="nav-group">
                    <div class="nav-label">Overview</div>
                    <!-- BACKEND: Home / Index -->
                    <a class="nav-link-r" href="index.html"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                </div>
                <div class="nav-group">
                    <div class="nav-label">People</div>
                    <!-- BACKEND: Member / Index  -->
                    <a class="nav-link-r" href="#"><i class="bi bi-people"></i> Members</a>
                    <!-- BACKEND: Trainer / Index  -->
                    <a class="nav-link-r" href="#"><i class="bi bi-person-badge"></i> Trainers</a>
                </div>
                <div class="nav-group">
                    <div class="nav-label">Gym</div>
                    <!-- BACKEND: Plan / Index -->
                    <a class="nav-link-r" href="plans.html"><i class="bi bi-tags"></i> Plans</a>
                    <!-- BACKEND: Membership / Index  -->
                    <a class="nav-link-r" href="#"><i class="bi bi-card-checklist"></i> Memberships</a>
                    <!-- BACKEND: Session / Index -->
                    <a class="nav-link-r" href="#"><i class="bi bi-calendar-week"></i> Sessions</a>
                </div>
            </nav>

            <div class="sidebar-foot">
                <span class="track-chip">.NET Track</span>
                <span>Route Academy</span>
            </div>
        </aside>
        <div class="scrim" data-nav-toggle></div>

        <div class="main">
            <header class="topbar">
                <button class="burger" type="button" data-nav-toggle aria-label="Open menu"><i class="bi bi-list"></i></button>
                <div class="crumbs">
                    <a href="index.html"><i class="bi bi-house-door"></i></a>
                    <span class="sep">/</span>
                    <!-- BACKEND: Current page name -->
                    <span class="here">Home Page</span>
                </div>
                <div class="topbar-right">
                    <!-- BACKEND: Today's date With Format dddd, d MMM yyyy -->
                    <span class="date-chip"><i class="bi bi-calendar3"></i> Tuesday, 17 Nov 2026</span>
                </div>
            </header>


            <!-- ==================== PAGE CONTENT: /Plan/Index ==================== -->
            <main class="content">

                <div class="page-head">
                    <div>
                        <h1 class="page-title">Plans</h1>
                        <p class="page-sub">What members can subscribe to</p>
                    </div>
                </div>

                <div class="callout" style="margin-bottom:22px">
                    <i class="bi bi-shield-check"></i>
                    <div>A plan with <strong>active or upcoming memberships</strong> is locked: it can't be edited or deactivated until those memberships end. Inactive plans can't be sold or edited.</div>
                </div>

                <!-- BACKEND: The page needs a list of plans from the database (all of them, active and inactive) -->

                <div class="grid-cards">

                    <!-- BACKEND: ONE card per plan The cards below are sample data -->
                    <div class="card-r plan-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                            <!-- BACKEND: Plan Name -->
                            <h2 class="plan-name">Basic Monthly</h2>
                            <!-- BACKEND: Badge depends on IsActive → "Active" (badge-ok) or "Inactive" (badge-mute) -->
                            <span class="badge-r badge-ok">Active</span>
                        </div>
                        <!-- BACKEND: Price formatted with thousands separator (1,800 not 1800.00) -->
                        <div class="plan-price">700<small>EGP</small></div>
                        <!-- BACKEND: DurationDays -->
                        <div class="plan-meta"><i class="bi bi-calendar-range"></i> 30 days</div>
                        <!-- BACKEND: Description -->
                        <p class="plan-desc">Full gym floor access during staffed hours.</p>
                        <div class="card-foot">
                            <!-- BACKEND: Edit page for this plan → needs the plan Id in the link -->
                            <a class="btn-r btn-outline-r btn-sm-r" href="#"><i class="bi bi-pencil"></i> Edit</a>
                            <!-- BACKEND: POST that switches IsActive (active → inactive) → needs the plan Id -->
                            <!-- data-confirm shows a confirm box before submitting (site.js) -->
                            <form action="#" method="post" style="flex:1;display:flex" data-confirm="Deactivate Basic Monthly? It won't be available for new memberships.">
                                <button type="submit" class="btn-r btn-soft-danger btn-sm-r" style="flex:1"><i class="bi bi-pause-circle"></i> Deactivate</button>
                            </form>
                        </div>
                    </div>

                    <div class="card-r plan-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                            <h2 class="plan-name">Standard Quarterly</h2>
                            <span class="badge-r badge-ok">Active</span>
                        </div>
                        <div class="plan-price">1,800<small>EGP</small></div>
                        <div class="plan-meta"><i class="bi bi-calendar-range"></i> 90 days</div>
                        <p class="plan-desc">Gym floor + group classes, one free PT session.</p>
                        <div class="card-foot">
                            <a class="btn-r btn-outline-r btn-sm-r" href="#"><i class="bi bi-pencil"></i> Edit</a>
                            <form action="#" method="post" style="flex:1;display:flex" data-confirm="Deactivate Standard Quarterly? It won't be available for new memberships.">
                                <button type="submit" class="btn-r btn-soft-danger btn-sm-r" style="flex:1"><i class="bi bi-pause-circle"></i> Deactivate</button>
                            </form>
                        </div>
                    </div>

                    <div class="card-r plan-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                            <h2 class="plan-name">Premium Half-Year</h2>
                            <span class="badge-r badge-ok">Active</span>
                        </div>
                        <div class="plan-price">3,200<small>EGP</small></div>
                        <div class="plan-meta"><i class="bi bi-calendar-range"></i> 180 days</div>
                        <p class="plan-desc">Unlimited classes, locker and a monthly body scan.</p>
                        <div class="card-foot">
                            <a class="btn-r btn-outline-r btn-sm-r" href="#"><i class="bi bi-pencil"></i> Edit</a>
                            <form action="#" method="post" style="flex:1;display:flex" data-confirm="Deactivate Premium Half-Year? It won't be available for new memberships.">
                                <button type="submit" class="btn-r btn-soft-danger btn-sm-r" style="flex:1"><i class="bi bi-pause-circle"></i> Deactivate</button>
                            </form>
                        </div>
                    </div>

                    <div class="card-r plan-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                            <h2 class="plan-name">Annual Elite</h2>
                            <span class="badge-r badge-ok">Active</span>
                        </div>
                        <div class="plan-price">5,500<small>EGP</small></div>
                        <div class="plan-meta"><i class="bi bi-calendar-range"></i> 365 days</div>
                        <p class="plan-desc">Everything included, 4 PT sessions and guest passes.</p>
                        <div class="card-foot">
                            <a class="btn-r btn-outline-r btn-sm-r" href="#"><i class="bi bi-pencil"></i> Edit</a>
                            <form action="#" method="post" style="flex:1;display:flex" data-confirm="Deactivate Annual Elite? It won't be available for new memberships.">
                                <button type="submit" class="btn-r btn-soft-danger btn-sm-r" style="flex:1"><i class="bi bi-pause-circle"></i> Deactivate</button>
                            </form>
                        </div>
                    </div>

                    <!-- BACKEND: INACTIVE plan (IsActive = false) looks different: -->
                    <!--   1) extra class "inactive" on the card   2) "Inactive" badge   3) no Edit button, only "Activate" -->
                    <div class="card-r plan-card inactive">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                            <h2 class="plan-name">Student Monthly</h2>
                            <span class="badge-r badge-mute">Inactive</span>
                        </div>
                        <div class="plan-price">450<small>EGP</small></div>
                        <div class="plan-meta"><i class="bi bi-calendar-range"></i> 30 days</div>
                        <p class="plan-desc">Off-peak access for students with a valid ID.</p>
                        <div class="card-foot">
                            <!-- BACKEND: Same POST as Deactivate (switches IsActive back to true), no confirm needed -->
                            <form action="#" method="post" style="flex:1;display:flex">
                                <button type="submit" class="btn-r btn-soft-ok btn-sm-r" style="flex:1"><i class="bi bi-play-circle"></i> Activate</button>
                            </form>
                        </div>
                    </div>

                </div>

                <!-- BACKEND: EMPTY STATE → show this INSTEAD of the cards when there are no plans. -->
                <!-- It's visible here only so you can see the design. -->
                <div class="card-r empty" style="margin-top:22px">
                    <div class="empty-icon"><i class="bi bi-tags"></i></div>
                    <h3>No plans found</h3>
                </div>

            </main>
            <!-- ================== END PAGE CONTENT ================== -->
        </div>
    </div>

    <!-- BACKEND: site.js -->
    <script src="~/js/site.js"></script>
</body>
</html>

